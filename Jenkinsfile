pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
            }
        }

        stage('Build') {
            steps {
                echo 'Building DevOps CI/CD application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }

        stage('Success') {
            steps {
                echo 'CI/CD Pipeline is working successfully!'
            }
        }
    }
}
